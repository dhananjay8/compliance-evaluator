# --- App ---
APP_ENV=local
APP_PORT=8090
LOG_LEVEL=INFO
LOG_JSON=true

# --- Elasticsearch ---
# Bundled compose ES (http://localhost:9200 from host /
# http://compliance-es:9200 in-network), or any external Elasticsearch.
ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ES_INDEX_PREFIX=

# --- Ollama / LLM ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_NUM_CTX=8192

# --- Embeddings ---
# ollama (default, nomic-embed-text=768d) | sentence_transformers (bge-small=384d)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768
EMBEDDING_BATCH_SIZE=32

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=8
MIN_SIMILARITY=0.5
MAX_EVIDENCE_CHUNKS=6
RETRIEVAL_BM25_CANDIDATES=8

# --- Uploads / security ---
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_ASSESSMENT=20
UPLOAD_DIR=./data/uploads

# --- Evaluation ---
CITATION_MAX_RETRIES=1
DEFAULT_FRAMEWORK=SOC2
CLASSIFIER_LLM_ENABLED=true
CLASSIFIER_LLM_THRESHOLD=0.55
